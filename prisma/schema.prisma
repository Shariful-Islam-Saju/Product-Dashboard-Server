  note                                                             String?            @db.Text
  created_by                                                       String?            @db.VarChar(50)
  created_date                                                     DateTime?          @db.Date
  created_time                                                     String?            @db.VarChar(50)
  system_ip                                                        String?            @db.VarChar(50)
  system_name                                                      String?            @db.VarChar(50)
  status                                                           Int?
  delete_bit                                                       Int?               @default(0)
  account_selection_name                                           String?            @db.VarChar(50)
  paymenttypes_id                                                  Int?
  customer_id                                                      Int?
  supplier_id                                                      Int?
  expense_id                                                       Int?
  db_store                                                         db_store?          @relation(fields: [store_id], references: [id], onDelete: Cascade, map: "ac_accounts_ibfk_1")
  db_paymenttypes                                                  db_paymenttypes?   @relation(fields: [paymenttypes_id], references: [id], onDelete: Cascade, map: "ac_accounts_ibfk_2")
  db_customers                                                     db_customers?      @relation(fields: [customer_id], references: [id], onDelete: Cascade, map: "ac_accounts_ibfk_3")
  db_suppliers                                                     db_suppliers?      @relation(fields: [supplier_id], references: [id], onDelete: Cascade, map: "ac_accounts_ibfk_4")
  db_expense_ac_accounts_expense_idTodb_expense                    db_expense?        @relation("ac_accounts_expense_idTodb_expense", fields: [expense_id], references: [id], onDelete: Cascade, map: "ac_accounts_ibfk_5")
  ac_moneydeposits_ac_moneydeposits_debit_account_idToac_accounts  ac_moneydeposits[] @relation("ac_moneydeposits_debit_account_idToac_accounts")
  ac_moneydeposits_ac_moneydeposits_credit_account_idToac_accounts ac_moneydeposits[] @relation("ac_moneydeposits_credit_account_idToac_accounts")
  ac_moneytransfer_ac_moneytransfer_debit_account_idToac_accounts  ac_moneytransfer[] @relation("ac_moneytransfer_debit_account_idToac_accounts")
  ac_moneytransfer_ac_moneytransfer_credit_account_idToac_accounts ac_moneytransfer[] @relation("ac_moneytransfer_credit_account_idToac_accounts")
  ac_transactions                                                  ac_transactions[]
  db_expense_db_expense_account_idToac_accounts                    db_expense[]       @relation("db_expense_account_idToac_accounts")

  @@index([customer_id], map: "customer_id")
  @@index([expense_id], map: "expense_id")
  @@index([paymenttypes_id], map: "paymenttypes_id")
  @@index([store_id], map: "store_id")
  @@index([supplier_id], map: "supplier_id")
}

